<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Alpha Mail - Temporary System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: #050505; color: #fff; overflow-x: hidden; }
        .glass { background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(15px); border: 1px solid rgba(255, 255, 255, 0.08); }
        .neon-border { box-shadow: 0 0 15px rgba(16, 185, 129, 0.2); }
        @keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .animate-mail { animation: slideUp 0.4s ease-out forwards; }
    </style>
</head>
<body class="min-h-screen p-4 flex flex-col items-center">
    
    <div class="w-full max-w-md mt-8 mb-8 text-center">
        <div class="inline-block p-3 rounded-2xl glass mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
        </div>
        <h1 class="text-2xl font-bold tracking-tight">Alpha Mail <span class="text-emerald-500 text-sm font-light">v2.0</span></h1>
    </div>

    <div class="w-full max-w-md glass rounded-[32px] p-6 shadow-2xl relative overflow-hidden mb-6">
        <div class="absolute top-0 right-0 p-4">
            <span id="status" class="flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
        </div>

        <label class="text-xs text-gray-500 uppercase tracking-widest font-semibold mb-2 block">Địa chỉ email của bạn</label>
        <div id="mailAddress" class="w-full bg-white/5 border border-white/10 p-4 rounded-2xl text-emerald-400 font-mono text-lg text-center break-all mb-4">
            Đang khởi tạo...
        </div>

        <div class="grid grid-cols-2 gap-3">
            <button onclick="generateMail()" class="bg-white text-black hover:bg-gray-200 py-3.5 rounded-2xl font-bold transition-all active:scale-95">Tạo Mới</button>
            <button onclick="copyMail()" class="glass hover:bg-white/10 py-3.5 rounded-2xl font-bold transition-all active:scale-95">Sao Chép</button>
        </div>
    </div>

    <div class="w-full max-w-md">
        <div class="flex justify-between items-center mb-4 px-2">
            <h2 class="text-lg font-semibold">Hộp thư đến</h2>
            <span id="refreshIcon" class="text-xs text-gray-500">Tự động cập nhật...</span>
        </div>
        
        <div id="inbox" class="space-y-4">
            <div class="text-center py-10">
                <p class="text-gray-600 text-sm">Chưa có thư nào được gửi đến địa chỉ này.</p>
            </div>
        </div>
    </div>

    <script>
        const GAS_URL = "httpshttps://script.google.com/macros/s/AKfycbw-coXTzqxEyXOEwJzR6DCzOx0olyaH34hroW3FI62h7zFW9VENd0h652OhK3wyEE2J/exec";
        const DOMAIN = "alphazone.io.vn"; // Thay đổi domain này theo ý anh

        function generateMail() {
            const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
            let randomStr = '';
            for (let i = 0; i < 8; i++) {
                randomStr += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            const newMail = `${randomStr}@${DOMAIN}`;
            document.getElementById("mailAddress").innerText = newMail;
            document.getElementById("inbox").innerHTML = '<div class="text-center py-10"><p class="text-gray-600 text-sm">Đang chờ thư cho ' + newMail + '...</p></div>';
        }

        async function checkMail() {
            const currentMail = document.getElementById("mailAddress").innerText;
            if (currentMail.includes("...")) return;

            try {
                const response = await fetch(`${GAS_URL}?mail=${currentMail}`);
                const mails = await response.json();
                
                if (mails.length > 0) {
                    let html = '';
                    mails.forEach(m => {
                        html += `
                        <div class="glass p-5 rounded-[24px] animate-mail border-l-2 border-emerald-500">
                            <div class="flex justify-between items-start mb-2">
                                <span class="text-emerald-400 font-bold text-xs uppercase tracking-tighter">Từ: ${m.from.split('<')[0]}</span>
                                <span class="text-[10px] text-gray-500 font-mono">${m.time}</span>
                            </div>
                            <h3 class="font-bold text-sm mb-1">${m.subject}</h3>
                            <p class="text-gray-400 text-xs leading-relaxed line-clamp-2">${m.content}</p>
                        </div>`;
                    });
                    document.getElementById("inbox").innerHTML = html;
                }
            } catch (e) {
                console.log("Checking...");
            }
        }

        function copyMail() {
            const text = document.getElementById("mailAddress").innerText;
            navigator.clipboard.writeText(text);
            // Hiệu ứng nút khi copy
            const btn = event.target;
            const originalText = btn.innerText;
            btn.innerText = "Đã chép!";
            setTimeout(() => btn.innerText = originalText, 1500);
        }

        // Khởi chạy
        window.onload = generateMail;
        setInterval(checkMail, 4000); // Check mỗi 4 giây
    </script>
</body>
</html>
